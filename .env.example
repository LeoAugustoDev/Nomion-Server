POSTGRES_DB=nomion
POSTGRES_USER=nomion
POSTGRES_PASSWORD=altere-esta-senha-local
POSTGRES_PORT=5433

# Keycloak local. Defina uma senha exclusiva antes de subir o serviço.
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KEYCLOAK_PROVISIONING_CLIENT_ID=nomion-provisioning
KEYCLOAK_PROVISIONING_CLIENT_SECRET=

# Habilite apenas durante o primeiro setup e use um token aleatorio de 32+ caracteres.
INITIAL_SETUP_ENABLED=false
INITIAL_SETUP_TOKEN=
INITIAL_SETUP_KEYCLOAK_SUBJECT=

# Gere um valor único com pelo menos 32 bytes em Base64 antes do uso.
JWT_SECRET=Y29uc3RpdHVhLXN1YS1jaGF2ZS1zZWNyZXRhLWp3dC1jb20tMzItYnl0ZXMtb3UtbWFpcw==
